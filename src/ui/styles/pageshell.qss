#pageShell {
    background: @page@;
}

#pageShellTools {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: @radius@px;
}

#pageShellContent {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: @radius@px;
}

#pageShellToolButton{
    color: @text@;
    background: transparent;
    border: none;
    padding: 8px 10px;
}

#pageShellToolIconButton {
    color: @text@;
    background: transparent;
    border: none;
    padding: 0;
}

#pageShellToolButton:hover,
#pageShellToolIconButton:hover {
    background: @hover@;
}

#pageShellToolButton[active="true"] {
    background: @selected@;
    color: @accent-text@;
}

#pageShellToolIconButton[active="true"] {
    background: @selected@;
    color: @accent@;
}

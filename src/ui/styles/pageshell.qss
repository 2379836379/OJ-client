#pageShell {
    background: @page@;
}

#pageShellTools {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: @radius@px;
}

#pageShellContent {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: @radius@px;
}

#pageShellToolsToggle,
#pageShellToolButton{
    color: @text@;
    background: transparent;
    border: none;
    padding: 8px 10px;
}

#pageShellToolsToggle:hover, 
#pageShellToolButton:hover,
#pageShellToolIconButton:hover {
    background: @hover@;
}

#pageShellToolIconButton {
    color: @text@;
    background: transparent;
    border: none;
    padding: 0;
}

#pageShellContent[framed="false"] {
    background: transparent;
    border: none;
}

#pageShellToolButton[active="true"] {
    background: @selected@;
    color: @accent-text@;
}

#pageShellPrimaryButton {
    background: @accent@;
    color: @accent-text@;
    border: none;
    padding: 8px 12px;
}

#pageShellContent {
    color: @text@;
}

#pageShellField {
    background: @field@;
    border: 1px solid @field-border@;
    color: @text@;
}
